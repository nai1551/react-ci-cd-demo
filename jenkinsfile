pipeline {
    agent any
    stages {

        stage('List current directory') {
            steps {
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Verify Node.js') {
            steps {
                sh '''
                    echo "===== NODE ====="
                    node --version

                    echo "===== NPM ====="
                    npm --version

                    echo "===== LOCATION ====="
                    which node
                    which npm
                '''
            }
        }

        stage('Checkout main branch') {
            steps {
                sh '''
                    git status
                    git checkout main
                    git pull
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Check code practices with ESLint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Format code with Prettier') {
            steps {
                sh 'npm run format'
            }
        }

        stage('Remove console.log statements') {
            steps {
                sh 'find . -name "node_modules" -prune -o -name "*.js" -exec sed -i \'/console\\.log(/d\' {} \\;'
            }
        }

        stage('Commit changes') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config --global user.email "mail.naim284@gmail.com"
                        git config --global user.name "nai1551"
                        git add .
                        git diff-index --quiet HEAD || git commit -m "Jenkins CI: perform integration steps"
                        git remote set-url origin https://$GITHUB_TOKEN@github.com/nai1551/react-ci-cd-demo.git
                        git push origin main
                    '''
                }
            }
        }

        stage('Run tests') {
            steps {
                sh 'CI=true npm test -- --watchAll=false'
            }
        }

        stage('Build app') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Clean up') {
            steps {
                sh 'rm -rf build'
            }
        }
    }

    post {
        success {
            echo 'React project CI pipeline completed successfully!'
        }
        failure {
            echo 'React project CI pipeline failed!'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
